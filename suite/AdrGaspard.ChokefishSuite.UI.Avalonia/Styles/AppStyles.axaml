<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="TextBlock.textblockStyle">
        <Setter Property="Foreground" Value="#F4F4F4" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.textboxStyle">
        <Setter Property="Foreground" Value="#F4F4F4" />
        <Setter Property="Background" Value="#202020" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="Label.labelStyle">
        <Setter Property="Foreground" Value="#F4F4F4" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.buttonStyle">
        <Setter Property="Foreground" Value="#F0F0F0" />
        <Setter Property="Background" Value="#404040" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#D0D0D0" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="10,2" />
    </Style>
    <Style Selector="Button.buttonStyle:pointerover">
        <Setter Property="Foreground" Value="DarkBlue" />
        <Setter Property="Background" Value="LightBlue" />
    </Style>
    <Style Selector="Button.buttonStyle:disabled">
        <Setter Property="Foreground" Value="#606060" />
        <Setter Property="Background" Value="Black" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="CheckBox.checkboxStyle">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="RadioButton.radiobuttonStyle">
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="RadioButton.radiobuttonStyle:not(:checked)">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="TabStripItem">
        <Setter Property="Background" Value="#404040" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#D0D0D0" />
        <Setter Property="Margin" Value="0,3,7,5" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#F0F0F0" />
    </Style>
    <Style Selector="TabStripItem:pointerover">
        <Setter Property="Background" Value="LightBlue" />
        <Setter Property="BorderBrush" Value="CornflowerBlue" />
        <Setter Property="Foreground" Value="DarkBlue" />
    </Style>
    <Style Selector="TabStripItem:selected">
        <Setter Property="Background" Value="#787878" />
        <Setter Property="BorderBrush" Value="#D0D0D0" />
        <Setter Property="Foreground" Value="#F0F0F0" />
    </Style>
    <Style Selector="Button.actionButtonStyle">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Margin" Value="3,0" />
    </Style>
    <Style Selector="TextBox.textboxStyle:focus">
        <Setter Property="BorderBrush" Value="#E0E0E0" />
    </Style>
    <Style Selector="Button.buttonStyle:focus">
        <Setter Property="BorderBrush" Value="#E0E0E0" />
    </Style>
</Styles>
